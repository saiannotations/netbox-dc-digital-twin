# Copy to .env and fill in (never commit .env).
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=change-me-postgres

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
NETBOX_SECRET_KEY=change-me-secret-key

NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=change-me-admin
# Token used as NETBOX_TOKEN when running the seed script
NETBOX_SUPERUSER_API_TOKEN=change-me-api-token
